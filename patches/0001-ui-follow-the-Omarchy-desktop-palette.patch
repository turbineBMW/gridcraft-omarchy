--- /dev/null
+++ b/crates/ui-egui/src/desktop_palette.rs
@@ -0,0 +1,298 @@
+//! The desktop's own colours, for the "Desktop colors" interface theme.
+//!
+//! The XDG Desktop Portal tells applications whether to draw light or dark ([`crate::desktop_theme`]),
+//! and on some desktops an accent colour, but nothing more. Omarchy publishes no accent there: it
+//! writes the current theme's whole palette to `~/.local/state/omarchy/current/theme/colors.toml`,
+//! a flat list of `name = "#rrggbb"` lines plus `mode = "light" | "dark"`, and replaces the file
+//! when the user switches themes. This module reads that file; [`crate::theme::Tokens::from_desktop`]
+//! turns it into the interface's colours. The sheet and everything drawn on it keep their own colours.
+//!
+//! Only the colours every Omarchy theme uses the same way are read: the background and its two
+//! darker steps, the foreground and the accent. The secondary names (`lighter_background`,
+//! `dark_foreground`, …) mean different things in different themes, so the rest is derived.
+
+use std::sync::mpsc::{Receiver, TryRecvError, channel};
+use std::time::Duration;
+
+use egui::Color32;
+
+/// How often [`PaletteWatch::start`] re-reads the file. A theme switch replaces files and links,
+/// which a file watcher would have to re-arm for; reading a 1 KB file once a second is cheaper
+/// to get right and reacts soon enough.
+const POLL: Duration = Duration::from_secs(1);
+
+/// The most of the file that is read. A real palette is under 1 KB; anything past this is not one.
+const MAX_BYTES: u64 = 64 * 1024;
+
+/// The desktop's palette, as the theme file states it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct DesktopPalette {
+    /// Whether the theme is dark: its `mode`, or, without one, whether the background is darker
+    /// than the foreground.
+    pub dark: bool,
+    pub background: Color32,
+    /// One step further from the foreground than `background` (a dark theme's darker strip, a
+    /// light theme's greyer one).
+    pub dark_background: Color32,
+    /// Two steps further.
+    pub darker_background: Color32,
+    pub foreground: Color32,
+    pub accent: Color32,
+}
+
+/// The palette in a theme file's text. `None` unless it names a background, a foreground and an
+/// accent; the other colours are made from those when missing. Every line that isn't a
+/// `key = "value"` pair is skipped, so comments and tables don't matter.
+pub fn parse(text: &str) -> Option<DesktopPalette> {
+    let mut background = None;
+    let mut dark_background = None;
+    let mut darker_background = None;
+    let mut foreground = None;
+    let mut accent = None;
+    let mut mode = None;
+    for line in text.lines() {
+        let Some((key, value)) = pair(line) else { continue };
+        match key {
+            "background" => background = hex(value),
+            "dark_background" => dark_background = hex(value),
+            "darker_background" => darker_background = hex(value),
+            "foreground" => foreground = hex(value),
+            "accent" => accent = hex(value),
+            "mode" => mode = Some(value.eq_ignore_ascii_case("dark")),
+            _ => {}
+        }
+    }
+    let (background, foreground, accent) = (background?, foreground?, accent?);
+    let dark = mode.unwrap_or_else(|| luminance(background) < luminance(foreground));
+    let step = |t: f32| crate::theme::mix(background, if dark { Color32::BLACK } else { foreground }, t);
+    Some(DesktopPalette {
+        dark,
+        background,
+        dark_background: dark_background.unwrap_or_else(|| step(0.25)),
+        darker_background: darker_background.unwrap_or_else(|| step(0.45)),
+        foreground,
+        accent,
+    })
+}
+
+/// A `key = "value"` line's key and unquoted value. Values may be single- or double-quoted, or bare
+/// up to a comment.
+fn pair(line: &str) -> Option<(&str, &str)> {
+    let line = line.trim();
+    if line.starts_with('#') || line.starts_with('[') {
+        return None;
+    }
+    let (key, rest) = line.split_once('=')?;
+    let key = key.trim().trim_matches(|c| c == '"' || c == '\'');
+    let rest = rest.trim();
+    let value = match rest.chars().next()? {
+        q @ ('"' | '\'') => rest.get(1..)?.split(q).next()?,
+        _ => rest.split(|c: char| c == '#' || c.is_whitespace()).next()?,
+    };
+    Some((key, value.trim()))
+}
+
+/// `#rrggbb`, `#rgb` or `#rrggbbaa` (alpha ignored), with or without the `#`.
+fn hex(value: &str) -> Option<Color32> {
+    let digits = value.trim().trim_start_matches('#');
+    if !digits.chars().all(|c| c.is_ascii_hexdigit()) {
+        return None;
+    }
+    let byte = |i: usize| digits.get(i..i + 2).and_then(|s| u8::from_str_radix(s, 16).ok());
+    let nibble = |i: usize| digits.get(i..i + 1).and_then(|s| u8::from_str_radix(s, 16).ok()).map(|n| n * 17);
+    match digits.len() {
+        6 | 8 => Some(Color32::from_rgb(byte(0)?, byte(2)?, byte(4)?)),
+        3 => Some(Color32::from_rgb(nibble(0)?, nibble(1)?, nibble(2)?)),
+        _ => None,
+    }
+}
+
+use crate::theme::luminance;
+
+/// The palette the desktop shows now, or `None` when there is none (not Omarchy, or the file is
+/// missing or unreadable).
+pub fn read() -> Option<DesktopPalette> {
+    read_text().as_deref().and_then(parse)
+}
+
+/// The theme file's text, from `$XDG_STATE_HOME` when that is set and then from
+/// `~/.local/state`, where Omarchy writes it.
+#[cfg(target_os = "linux")]
+fn read_text() -> Option<String> {
+    use std::io::Read;
+    let state = std::env::var_os("XDG_STATE_HOME").map(std::path::PathBuf::from).filter(|p| p.is_absolute());
+    let home = std::env::var_os("HOME").filter(|h| !h.is_empty()).map(|h| std::path::PathBuf::from(h).join(".local/state"));
+    for dir in state.into_iter().chain(home) {
+        let Ok(file) = std::fs::File::open(dir.join("omarchy/current/theme/colors.toml")) else { continue };
+        let mut text = String::new();
+        if file.take(MAX_BYTES).read_to_string(&mut text).is_ok() {
+            return Some(text);
+        }
+    }
+    None
+}
+
+/// Omarchy is Linux only.
+#[cfg(not(target_os = "linux"))]
+fn read_text() -> Option<String> {
+    None
+}
+
+/// Watches the theme file and reports the palette when it changes.
+#[derive(Default)]
+pub struct PaletteWatch {
+    /// `None` when no watcher thread could be started.
+    changes: Option<Receiver<Option<DesktopPalette>>>,
+}
+
+impl PaletteWatch {
+    /// Start watching. The first answer is sent straight away; later ones only once two reads a
+    /// poll apart agree, so a theme switch caught halfway (the file missing or half written for
+    /// a moment) never flashes another palette. `changed` runs on the watcher's thread after each
+    /// answer (the app asks for a repaint there). Only the app binary starts this, so tests and
+    /// headless screenshots never depend on the host's theme.
+    pub fn start(changed: impl Fn() + Send + 'static) -> Self {
+        let (tx, rx) = channel();
+        let started = std::thread::Builder::new().name("gridcraft-desktop-palette".into()).spawn(move || {
+            let mut shown = read();
+            if tx.send(shown).is_err() {
+                return;
+            }
+            changed();
+            let mut previous = shown;
+            loop {
+                std::thread::sleep(POLL);
+                let now = read();
+                if now == previous && now != shown {
+                    shown = now;
+                    if tx.send(now).is_err() {
+                        return;
+                    }
+                    changed();
+                }
+                previous = now;
+            }
+        });
+        Self { changes: started.ok().map(|_| rx) }
+    }
+
+    /// Whether a watcher thread is running.
+    pub fn watching(&self) -> bool {
+        self.changes.is_some()
+    }
+
+    /// The palette if it changed since the last call (`Some(None)`: the desktop no longer has one),
+    /// polled once a frame. Several changes in one frame collapse to the newest.
+    pub fn take_change(&mut self) -> Option<Option<DesktopPalette>> {
+        let changes = self.changes.as_ref()?;
+        let mut newest = None;
+        loop {
+            match changes.try_recv() {
+                Ok(palette) => newest = Some(palette),
+                Err(TryRecvError::Empty) | Err(TryRecvError::Disconnected) => return newest,
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const LIGHT: &str = r##"
+# A made-up light theme.
+mode = "light"
+accent = "#c06a2b"
+background = "#faf4ec"
+dark_background = "#efe6da"
+darker_background = "#e3d8ca"
+foreground = "#2b2622"
+red = "#b0302a"
+"##;
+
+    #[test]
+    fn a_theme_file_reads_as_a_palette() {
+        let p = parse(LIGHT).unwrap();
+        assert!(!p.dark);
+        assert_eq!(p.background, Color32::from_rgb(0xFA, 0xF4, 0xEC));
+        assert_eq!(p.darker_background, Color32::from_rgb(0xE3, 0xD8, 0xCA));
+        assert_eq!(p.foreground, Color32::from_rgb(0x2B, 0x26, 0x22));
+        assert_eq!(p.accent, Color32::from_rgb(0xC0, 0x6A, 0x2B));
+    }
+
+    /// Without a mode the background decides; without the background steps they are made.
+    #[test]
+    fn missing_mode_and_steps_are_derived() {
+        let p = parse("background = '#101010'\nforeground = \"#e0e0e0\"\naccent = abcdef # bare\n").unwrap();
+        assert!(p.dark);
+        assert_eq!(p.accent, Color32::from_rgb(0xAB, 0xCD, 0xEF));
+        assert!(luminance(p.dark_background) < luminance(p.background));
+        assert!(luminance(p.darker_background) < luminance(p.dark_background));
+    }
+
+    /// A file without the three colours the interface needs is no palette.
+    #[test]
+    fn an_incomplete_file_is_no_palette() {
+        assert_eq!(parse(""), None);
+        assert_eq!(parse("background = \"#fff\"\nforeground = \"#000\""), None);
+        assert_eq!(parse("background = \"#fff\"\nforeground = \"#000\"\naccent = \"blue\""), None);
+    }
+
+    /// Junk never panics: half-written lines, odd quoting, multi-byte text, wrong lengths.
+    #[test]
+    fn hostile_text_never_panics() {
+        for junk in [
+            "=",
+            "==",
+            "a=",
+            "=\"",
+            "accent = \"",
+            "accent = '#12",
+            "accent = #+12345",
+            "accent = \"#ééé\"",
+            "accent = \"#1234567\"",
+            "background = \"#\u{1F600}\u{1F600}\"",
+            "[table]\nkey",
+            "\u{0}\u{FFFF}",
+            "accent=\"#fff",
+            "mode",
+        ] {
+            let _ = parse(junk);
+        }
+        assert_eq!(hex("+12345"), None, "from_str_radix would take a sign");
+        assert_eq!(hex("#ééé"), None);
+        assert_eq!(hex("#12345"), None);
+        assert_eq!(hex("#aBc"), Some(Color32::from_rgb(0xAA, 0xBB, 0xCC)));
+        assert_eq!(hex("#11223380"), Some(Color32::from_rgb(0x11, 0x22, 0x33)));
+    }
+
+    #[test]
+    fn a_watcher_without_a_thread_is_inert() {
+        assert_eq!(PaletteWatch::default().take_change(), None);
+    }
+
