+        set_desktop_tokens(&ctx, Some(Tokens::from_desktop(&p)));
+        ctx.set_theme(egui::Theme::Light);
+        ctx.run_ui(Default::default(), |_| {}).textures_delta.clear();
+        assert_eq!(Tokens::get(&ctx).ribbon, p.background);
+        assert_eq!(ctx.global_style().visuals.panel_fill, p.dark_background);
+        // Font setup re-applies the style; the desktop palette stays.
+        apply(&ctx, false);
+        ctx.run_ui(Default::default(), |_| {}).textures_delta.clear();
+        assert_eq!(ctx.global_style().visuals.panel_fill, p.dark_background);
+        set_desktop_tokens(&ctx, None);
+        ctx.run_ui(Default::default(), |_| {}).textures_delta.clear();
+        assert_eq!(Tokens::get(&ctx).ribbon, Tokens::light().ribbon);
